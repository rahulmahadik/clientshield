# ClientShield environment variables (placeholders only — never commit real values)

# LLM provider (optional; the app runs fully rule-based without it)
DASHSCOPE_API_KEY=your-api-key
DASHSCOPE_BASE_URL=https://dashscope.example.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Owner sign-in session signing secret (generate with: openssl rand -hex 32)
OWNER_SESSION_SECRET=your-session-secret

# Optional owner credential overrides (defaults: owner / clientshield)
OWNER_USERNAME=owner
OWNER_PASSWORD=clientshield
